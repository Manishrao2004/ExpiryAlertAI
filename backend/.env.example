# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Option A: Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/expiryalert

# Option B: MongoDB Atlas (replace with your connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expiryalert

# ─── Frontend Origin ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── VAPID Email (appears in push notification headers) ───────────────────────
VAPID_EMAIL=admin@expiryalert.app

# ─── OpenRouter AI (optional – powers the LLM expiry date parser) ─────────────
# Free key available at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── LLM Model (leave blank for default) ─────────────────────────────────────
# Example: mistralai/mistral-7b-instruct
LLM_MODEL=
